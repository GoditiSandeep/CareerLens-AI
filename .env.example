# ============================================================
# CareerLens AI - Environment configuration
# Copy this file to .env and fill in your values.
# The application works out-of-the-box in MOCK_AI_MODE without
# any API keys.
# ============================================================

# ---------- App ----------
APP_NAME=CareerLens AI
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
# Frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Database ----------
# Use SQLite for local testing (default).
DATABASE_URL=sqlite:///./careerlens.db
# PostgreSQL (when available):
# DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens

# ---------- AI Provider ----------
# Options: mock | openai | gemini
# When "mock" or when no key is provided, the app uses a built-in
# deterministic MOCK_AI_MODE so it always runs without a key.
AI_PROVIDER=mock
MOCK_AI_MODE=true

# OpenAI-compatible API key (e.g. OpenAI, Groq, Together, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Seed ----------
# Seed the database with demo data on startup (creates demo account)
SEED_DEMO_DATA=true
