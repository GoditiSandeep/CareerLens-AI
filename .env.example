# ============================================================
# CareerLens AI - Environment configuration
# Copy this file to .env and fill in your values.
# The application works out-of-the-box in MOCK_AI_MODE without
# any API keys.
# ============================================================

# ---------- App ----------
APP_NAME=CareerLens AI
# development | staging | production
# In production the backend REFUSES to start unless: SECRET_KEY is a real
# value of >= 32 chars (placeholders are rejected), DEBUG=false, and
# CORS_ORIGINS does not contain localhost.
ENVIRONMENT=development
DEBUG=true
# REQUIRED in production — generate a unique value (never reuse this placeholder):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
# Frontend origin(s), comma separated.
# Production: set to your real origin(s), e.g. https://app.example.com
# (localhost is rejected when ENVIRONMENT=production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Database ----------
# Use SQLite for local testing (default).
DATABASE_URL=sqlite:///./careerlens.db
# PostgreSQL (when available):
# DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens

# ---------- AI Provider ----------
# Options: mock | openai | gemini
# When "mock" or when no key is provided, the app uses a built-in
# deterministic MOCK_AI_MODE so it always runs without a key.
AI_PROVIDER=mock
MOCK_AI_MODE=true

# OpenAI-compatible API key (e.g. OpenAI, Groq, Together, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Seed ----------
# Seed the database with demo data on startup (creates demo account)
SEED_DEMO_DATA=true

# ---------- Production deployment (see DEPLOYMENT.md) ----------
# Use docker-compose.prod.example.yml (copy to docker-compose.prod.yml) and
# provide these values in a local .env — .env files are git-ignored and
# docker-ignored, so real secrets never reach Git or Docker images:
#   SECRET_KEY / POSTGRES_PASSWORD  generate: python -c "import secrets; print(secrets.token_hex(32))"
#   CORS_ORIGINS                    real frontend origin(s), e.g. https://app.example.com
#   VITE_API_URL                    public backend origin (frontend IMAGE build arg,
#                                   e.g. https://api.example.com — baked into the bundle)
